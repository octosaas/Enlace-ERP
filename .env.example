# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENLACE ERP - CONFIGURAÇÕES DE AMBIENTE
PORT=3000
NODE_ENV=development

# Segredo criptográfico para tokens JWT de sessão de usuário (mínimo 32 caracteres em produção)
JWT_SECRET=

# Chave mestre de criptografia do Credential Vault AES-256-GCM (32 bytes / 256 bits)
ENLACE_VAULT_KEY=

# Conexão PostgreSQL (quando disponível em produção/staging/docker)
# Ex: postgresql://enlace_user:password@localhost:5432/enlace_erp
DATABASE_URL=
POSTGRES_USER=enlace_user
POSTGRES_PASSWORD=
POSTGRES_DB=enlace_erp

