# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENLACE ERP - CONFIGURAÇÕES DE AMBIENTE
PORT=3000
NODE_ENV=development

# Segredo criptográfico para tokens JWT de sessão de usuário
JWT_SECRET="enlace_erp_secure_development_secret_key_2026_change_in_prod"

# Conexão PostgreSQL (quando disponível em produção/staging)
# Ex: postgresql://user:password@localhost:5432/enlace_erp
DATABASE_URL=

